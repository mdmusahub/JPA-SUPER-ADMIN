<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mdmusahub</groupId>
    <artifactId>jpa-super-admin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jpa-admin-core</artifactId>
  <packaging>jar</packaging>

  <name>JPA Admin Core</name>
  <description>Metadata, services, controllers and view-model records.</description>

  <dependencies>
    <!--
      Optional: compile-time only, for the controllers. The starter brings the web stack (D-30), and the
      auto-configuration backs off when it is missing (ARCH-7), so the view-model records and the preview app,
      which use this module without a web stack of their own, are not affected.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Provided: the JPA API the scanner and the count service are written against (metamodel, EntityManager,
      Criteria). Provided, not compile, so it is not transitive and the starter never adds JPA to a host: every host
      of this console already has it, and the auto-configuration backs off when it does not (ARCH-7). Version from
      the Boot BOM (3.2.0).
    -->
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Provided, for the same reason: @Transactional(readOnly = true) on the read services (ARCH-5). Any host with
      Spring Data JPA has spring-tx at run time. Version from the Boot BOM.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      Provided (D-75): only the annotation types and ConstraintViolationException, to read the constraints of a field and to
      turn a violation into a plain sentence for that field. Hibernate Validator itself is the host's choice: the console
      works without it, and when the host has it (Boot's validation starter) its violations are mapped to field messages.
      Provided, not compile, so nothing is added to a host. Version from the Boot BOM.
    -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      Test scope only: a real Hibernate EntityManagerFactory over H2, so the scanner is tested against a real JPA
      metamodel instead of a hand-made one. The tests bootstrap it with plain JPA (persistence.xml), so no Spring
      Boot context is started in this module.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test scope only (D-34): MockHttpServletRequest and friends for the controller and resolver unit tests. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Test scope only (Phase 14a, approved by the maintainer; D-19 named them): the same list, search, sort, filter, export,
      detail, write, delete and chart tests run on a real PostgreSQL and a real MySQL, started in a container. The versions come
      from the Spring Boot 4.1.2 BOM (Testcontainers 2.0.5, PostgreSQL JDBC 42.7.14, MySQL Connector/J 9.7.0). The JUnit extension
      (testcontainers-junit-jupiter) is not used: the shared test base starts the container itself so that a missing Docker
      fails on CI and skips with a reason elsewhere.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            Phase 14a (D-131): the performance measurements (everything under .../perf) are NOT part of a normal build. They load
            200,000 rows and run for minutes; they are switched on only by the profile "perf" below, and every one of them also
            refuses to run without the system property that profile sets. Surefire's own default exclusion of nested classes is kept.
          -->
          <excludes>
            <exclude>**/*$*</exclude>
            <exclude>**/perf/**</exclude>
          </excludes>
          <!--
            Phase 14a (D-130): test output goes to target/surefire-reports, so the public CI log never shows what a test logs. Three tests
            of this module raise the log level to TRACE on purpose, to prove that a ticket is never logged; without this setting their
            output, with the values Hibernate binds to a (made-up) record, reached the CI console (found by searching a full CI-style log).
            BuildSettingsGuardTest in sample-app and TestOutputGoesToFilesTest here fail the build if the setting is lost.
          -->
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The performance measurements (Phase 14a, D-131):   mvn -B -pl jpa-admin-core -Pperf test
      Never active by default: it has no <activation>, and PerfProfileIsOffByDefaultTest fails the normal build if that changes, if
      the default build stops excluding the measurements, or if a measurement class loses its own switch. Needs Docker for the
      PostgreSQL measurements (skipped with the reason where there is none). The report lands in target/perf-report-*.md.
    -->
    <profile>
      <id>perf</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludes combine.self="override">
                <exclude>**/*$*</exclude>
              </excludes>
              <includes combine.self="override">
                <include>**/perf/*PerfTest.java</include>
              </includes>
              <systemPropertyVariables>
                <jpa.admin.perf>true</jpa.admin.perf>
              </systemPropertyVariables>
              <argLine>-Xmx3g</argLine>
              <redirectTestOutputToFile>true</redirectTestOutputToFile>
              <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
