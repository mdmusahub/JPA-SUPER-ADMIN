<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mdmusahub</groupId>
    <artifactId>jpa-super-admin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jpa-admin-core</artifactId>
  <packaging>jar</packaging>

  <name>JPA Admin Core</name>
  <description>Metadata, services, controllers and view-model records.</description>

  <dependencies>
    <!--
      Optional: compile-time only, for the controllers. The starter brings the web stack (D-30), and the
      auto-configuration backs off when it is missing (ARCH-7), so the view-model records and the preview app,
      which use this module without a web stack of their own, are not affected.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Provided: the JPA API the scanner and the count service are written against (metamodel, EntityManager,
      Criteria). Provided, not compile, so it is not transitive and the starter never adds JPA to a host: every host
      of this console already has it, and the auto-configuration backs off when it does not (ARCH-7). Version from
      the Boot BOM (3.2.0).
    -->
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Provided, for the same reason: @Transactional(readOnly = true) on the read services (ARCH-5). Any host with
      Spring Data JPA has spring-tx at run time. Version from the Boot BOM.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      Test scope only: a real Hibernate EntityManagerFactory over H2, so the scanner is tested against a real JPA
      metamodel instead of a hand-made one. The tests bootstrap it with plain JPA (persistence.xml), so no Spring
      Boot context is started in this module.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test scope only (D-34): MockHttpServletRequest and friends for the controller and resolver unit tests. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
