<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mdmusahub</groupId>
    <artifactId>jpa-super-admin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jpa-admin-autoconfigure</artifactId>
  <packaging>jar</packaging>

  <name>JPA Admin Autoconfigure</name>
  <description>Properties, security chain and auto-configuration.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-core</artifactId>
    </dependency>

    <!--
      Optional: compile-time only. The starter brings the web stack (D-30), and the auto-configuration backs off
      when it is missing (ARCH-7), so this module imposes nothing on a host application.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Optional: generates META-INF/spring-configuration-metadata.json for IDE completion of jpa.admin.* -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test scope only (approved in D-19): puts jakarta.persistence.EntityManager on the test classpath so the
      "JPA present" condition can be tested. Main code checks that class by name and has no JPA dependency.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
