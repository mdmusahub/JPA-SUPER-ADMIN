<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mdmusahub</groupId>
    <artifactId>jpa-super-admin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jpa-super-admin-spring-boot-starter</artifactId>
  <packaging>pom</packaging>

  <name>JPA Super Admin Spring Boot Starter</name>
  <description>The only dependency users add.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-ui</artifactId>
    </dependency>

    <!--
      The web stack the console needs (D-30). core and autoconfigure declare it as optional, so it reaches a host
      application through this starter. A host already has JPA; the starter does not add it.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!--
      Sign-in (D-34). The two Spring Security libraries, not spring-boot-starter-security: that starter also brings
      spring-boot-security, Boot's security auto-configuration, which would protect every route of a host that never
      asked for Spring Security and log a generated password. A host that wants Boot's security adds that starter
      itself, and the console then joins the host's chains (D-35). Versions come from the Boot BOM.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-config</artifactId>
    </dependency>

    <!--
      The console's pages are Thymeleaf templates in jpa-admin-ui, rendered by the console's own private engine (D-40).
      Only the Thymeleaf-Spring library, not spring-boot-starter-thymeleaf: that starter also brings
      spring-boot-thymeleaf, Boot's Thymeleaf auto-configuration, which would give a host that has no Thymeleaf a
      view resolver, a template engine and spring.thymeleaf.* settings it never asked for. A host that wants Thymeleaf
      adds that starter itself, and the console neither uses nor changes it. Version from the Boot BOM.
    -->
    <dependency>
      <groupId>org.thymeleaf</groupId>
      <artifactId>thymeleaf-spring6</artifactId>
    </dependency>
  </dependencies>
</project>
