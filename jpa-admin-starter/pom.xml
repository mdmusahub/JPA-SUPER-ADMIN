<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mdmusahub</groupId>
    <artifactId>jpa-super-admin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jpa-super-admin-spring-boot-starter</artifactId>
  <packaging>pom</packaging>

  <name>JPA Super Admin Spring Boot Starter</name>
  <description>The only dependency users add.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-ui</artifactId>
    </dependency>

    <!--
      The web stack the console needs (D-30). core and autoconfigure declare it as optional, so it reaches a host
      application through this starter. A host already has JPA; the starter does not add it.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
  </dependencies>
</project>
