<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mdmusahub</groupId>
    <artifactId>jpa-super-admin</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jpa-admin-ui</artifactId>
  <packaging>jar</packaging>

  <name>JPA Admin UI</name>
  <description>Thymeleaf templates, CSS and JavaScript for the console (resources only).</description>

  <properties>
    <!--
      Release profile only matters (Phase 14b, D-142): this module has no public class, and the Javadoc tool refuses a module
      with nothing public to document ("No public or protected classes found to document"). Maven Central asks for a Javadoc jar
      with every jar, so the Javadoc plugin is told to show package-private members here, which documents the one package-private
      class (ResourceFolders) and the package page. The property is the plugin's own user property "show".
    -->
    <show>package</show>
  </properties>
</project>
