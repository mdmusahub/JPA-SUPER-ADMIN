<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mdmusahub</groupId>
    <artifactId>jpa-super-admin</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jpa-admin-ui-preview</artifactId>
  <packaging>jar</packaging>

  <name>JPA Admin UI Preview</name>
  <description>Unpublished preview app that renders the real templates with fixtures. Never a dependency of any module.</description>

  <!--
    Not published (Phase 14b, D-138; ARCH-11 keeps it out of every dependency list). These apply to every build, not only the release
    profile, so this module never gets a source jar, a javadoc jar, a signature or a deployment, whatever profile or command is used.
    The release profile also lists it in the Central plugin's excludeArtifacts, and a test reads both.
  -->
  <properties>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <gpg.skip>true</gpg.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mdmusahub</groupId>
      <artifactId>jpa-admin-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- MockMvc to render every fixture page in a test (D-34); Boot 4 split web test support out of starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
